POSTGRES_PORT=15432
POSTGRES_ADMIN_PASSWORD=<set-locally>
AUTH_DB_PASSWORD=<set-locally>
PROJECT_DB_PASSWORD=<set-locally>
INTERVIEW_DB_PASSWORD=<set-locally>
PROJECT_PORT=18081
PROJECT_DB_URL=jdbc:postgresql://127.0.0.1:15432/devfield_dev?currentSchema=project
PROJECT_DB_USER=devfield_project
PROJECT_AUTH_ISSUER=<match-auth-issuer>
PROJECT_AUTH_AUDIENCE=<match-auth-audience>
PROJECT_AUTH_JWKS_URI=http://127.0.0.1:18080/api/auth/jwks
PROJECT_AUTH_SESSION_CHECK_URI=http://127.0.0.1:18080/internal/auth/session-check
PROJECT_AUTH_SERVICE_KEY=<set-locally>
PROJECT_GITHUB_TOKEN=
PROJECT_GITHUB_APP_ID=<set-app-id>
PROJECT_GITHUB_APP_CLIENT_ID=<set-client-id>
PROJECT_GITHUB_APP_CLIENT_SECRET=<set-locally>
PROJECT_GITHUB_APP_PRIVATE_KEY_PATH=<local-private-key-path>
PROJECT_GITHUB_APP_CALLBACK_URL=http://127.0.0.1:18083/api/github/connections/callback
PROJECT_GITHUB_APP_SETUP_URL=http://127.0.0.1:18083/api/github/connections/setup
PROJECT_GITHUB_APP_INSTALL_URL=https://github.com/apps/<app-slug>/installations/new
PROJECT_GITHUB_USER_TOKEN_REFRESH_SKEW_SECONDS=120
PROJECT_GITHUB_ATTEMPT_TTL_SECONDS=600
PROJECT_GITHUB_TOKEN_KEY_VERSION=1
PROJECT_GITHUB_TOKEN_KEY=<base64-encoded-random-32-byte-key>
PROJECT_GITHUB_API_TIMEOUT_SECONDS=8
INTERVIEW_PORT=18082
INTERVIEW_DB_URL=jdbc:postgresql://127.0.0.1:15432/devfield_dev?currentSchema=interview
INTERVIEW_DB_USER=devfield_interview
AUTH_PORT=18080
AUTH_DB_URL=jdbc:postgresql://127.0.0.1:15432/devfield_dev?currentSchema=auth
AUTH_DB_USER=devfield_auth
